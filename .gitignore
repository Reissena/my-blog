# Hugo 构建产物
public/
resources/_gen/
.hugo_build.lock

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 本地环境文件
.env

# Hugo cache
.hugo_cache/

# /site/ 站点数据页的访问量数据：每次构建由 tools/fetch-site-stats.mjs 现查现写，
# **不进仓库**（里面是运行数据，会天天变；提交一份反而会让页面显示过期的数）。
# 这样「文件在不在」就等于「这次构建到底查没查到」，页面的降级判断只有一个依据。
# 详见 docs/访问统计.md §7.5。
data/site_stats.yaml
data/site_stats.yaml.tmp

# Wrangler local cache (机器相关，不要提交)
.wrangler/

# Python 缓存（tools/*.py 跑一次就会生成，别提交）
__pycache__/
*.pyc

# 音乐 mp3 已迁移到 Cloudflare R2（桶 blog-music），仓库里只留封面与歌词；
# 这条是防止以后手滑又把几百 MB 音频提交进来。
static/music/*.mp3

# 本地验证用的临时脚本目录（CDP 测试脚本等，不要提交）
.chrome-test/
